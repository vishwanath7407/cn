import matplotlib.pyplot as plt

def bresenham_line(x1, y1, x2, y2): # [cite: 71]
    # Calculate differences
    dx = x2 - x1 # [cite: 72]
    dy = y2 - y1 # [cite: 73]
    
    # Initialize decision parameter
    p = 2 * dy - dx # [cite: 74]
    
    x = x1 # [cite: 75]
    y = y1 # [cite: 75]
    
    points = [] # [cite: 76]
    points.append((x, y)) # [cite: 77]
    
    # Generate points along the line
    while x < x2: # [cite: 78]
        x += 1 # [cite: 79]
        if p < 0: # [cite: 80]
            p = p + 2 * dy # [cite: 82]
        else: # [cite: 81]
            y += 1 # [cite: 83]
            p = p + 2 * (dy - dx) # [cite: 84]
        points.append((x, y)) # [cite: 85]
        
    return points # [cite: 86]

# Given start and end points
x1, y1 = 3, 2 # [cite: 88]
x2, y2 = 17, 5 # [cite: 89]

# Run the algorithm
line_points = bresenham_line(x1, y1, x2, y2) # [cite: 90]

# Print coordinates to the terminal console
print("Points generated by Bresenham's Line Algorithm:") # [cite: 91, 94]
for point in line_points:
    print(point)

# Separate x and y coordinates for plotting
x_coords = [p[0] for p in line_points]
y_coords = [p[1] for p in line_points]

# Plot configuration matching your document layout
plt.plot(x_coords, y_coords, marker='o', linestyle='-')
plt.xlabel("X-axis") # [cite: 120]
plt.ylabel("Y-axis") # [cite: 93]
plt.title("Bresenham's Line Generation Output for Points (3,2) to (17,5)") # 
plt.grid(True)

# Render the graph window
plt.show()
